<Project>
  <PropertyGroup>
    <!--
      本番ターゲットは .NET 8 LTS。
      ただし開発機に .NET 9 ランタイムしか無い場合でも build / test / run できるよう、
      実行時のメジャーロールフォワードを許可する（.NET 8 ランタイムがあればそちらが優先される）。
    -->
    <RollForward>Major</RollForward>

    <!--
      依存ライブラリの脆弱性自動検知（セキュリティ対策）。
      restore / build 時に、既知の脆弱性を持つ NuGet パッケージ（直接・推移的の両方）を警告する。
      定期確認は dotnet list package の vulnerable 診断でも実施可能（詳細は docs/security-checklist.md）。
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- 乙欄（従たる給与・賞与）の源泉税表がブラウザ版DBに無い場合に、移行元DBから該当表をコピーして修復する。
       既定は診断のみ（読み取り）。fixフラグでコピーを実行する。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PayCalcDXPro.OtsuTaxFix</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PayCalcDXPro.Data\PayCalcDXPro.Data.csproj" />
    <ProjectReference Include="..\..\src\PayCalcDXPro.Domain\PayCalcDXPro.Domain.csproj" />
  </ItemGroup>

</Project>

@page "/year-end/realestate"
@using PayCalcDXPro.Data.YearEnd
@using PayCalcDXPro.Data.MyNumber
@inject PayCalcDXPro.Web.LocalDatabaseService Db
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>不動産の使用料等の支払調書｜給与計算DXPro</PageTitle>

@* 明細テーブル：#列は報酬と同様に狭く（ye-amount-table 基底の first-child width:100% を上書き）。
   文字列列（区分・物件の所在地・細目・計算の基礎）は左詰め、支払金額のみ右詰め。物件の所在地が残り幅を使う。 *@
<style>
    .re-detail th, .re-detail td { text-align: left; }
    .re-detail td.re-detail__num, .re-detail th.re-detail__num { text-align: right; }
    .re-detail td input { text-align: left !important; }
    .re-detail td.re-detail__num input { text-align: right !important; }
    /* 列幅（#削除後：1区分／2物件の所在地／3細目／4計算の基礎／5支払金額）。物件の所在地が残り幅を使う。 */
    .re-detail th:nth-child(1), .re-detail td:nth-child(1) { width: 100%; min-width: 12em; }    /* 区分：可変・最小12em、残りウィンドウ幅を使う */
    .re-detail th:nth-child(2), .re-detail td:nth-child(2) { width: 22em; min-width: 22em; }    /* 物件の所在地：22em固定 */
    .re-detail th:nth-child(3), .re-detail td:nth-child(3) { width: 12em; min-width: 12em; }    /* 細目：12em固定 */
    .re-detail th:nth-child(4), .re-detail td:nth-child(4) { width: 12em; min-width: 12em; }    /* 計算の基礎：12em固定 */
    /* 法人／個人の区分ラジオを横並びに。radio-group を flex-row にしても、各ラジオのラッパー .mud-input-control が
       全幅(flex:1 1 auto)に伸びて flex-wrap で1個ずつ折り返し縦積みになる → 子ラッパーを内容幅(flex:0 0 auto/width:auto)に固定する。 */
    .pay-row .mud-radio-group {
        display: flex !important; flex-direction: row !important; align-items: center; flex-wrap: wrap; column-gap: 1.25rem;
    }
    .pay-row .mud-radio-group > .mud-input-control {
        flex: 0 0 auto !important; width: auto !important; max-width: none !important;
    }
    /* MudRadioGroup ルート自体も内容幅に固定（既定 flex:1 1 auto だと親フレックス幅いっぱいに伸び、右横の番号欄が下へ折り返される）。 */
    .re-kbn-radio { flex: 0 0 auto !important; width: auto !important; }
    /* 2カラムレイアウト（報酬と同じ）：左列(氏名等)は狭く、右列(住所等)を広く。
       画面幅が狭くなると1カラムに落ち、右列が下段へ回り込む。全幅行(区分ラジオ)は常にスパン。 */
    .pay-list.pay-list--2col { display: grid; grid-template-columns: minmax(12em, 1fr) minmax(20em, 2fr); column-gap: 1.75rem; align-items: start; }
    .pay-list.pay-list--2col > .pay-row--full { grid-column: 1 / -1; }
    /* 狭い列（支払確定年月日等）でラベルが省略(…)されないよう縮小を止め、値側を縮ませる。 */
    .pay-list.pay-list--2col .pay-row__label { flex-shrink: 0; }
    @@media (max-width: 960px) {
        .pay-list.pay-list--2col { grid-template-columns: 1fr; }
    }
</style>

@* 固定ヘッダー：整理番号選択＋新規＋保存/削除/印刷。 *@
<MudPaper Elevation="2" Square="true" Class="page-sticky-header py-3 px-2">
    <div class="proc-header__bar proc-header__bar--stacked">
        <div class="proc-header__title">
            <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h5">不動産の使用料等の支払調書</MudText>
        </div>
        <div class="proc-header__main">
            <div class="proc-header__controls">
                <MudSelect T="int?" Value="_selectedNo" ValueChanged="On整理番号Changed" Label="整理番号"
                           Variant="Variant.Outlined" Dense="true" Style="min-width:280px;" Clearable="true">
                    @foreach (var t in _list)
                    {
                        <MudSelectItem T="int?" Value="@t.No">@t.No　@t.名称</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="新規">新規</MudButton>
            </div>
            <div class="proc-header__actions">
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="削除" Disabled="_e.No <= 0 || _busy">削除</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print"
                           Href="@(_e.No > 0 ? $"/year-end/realestate/pdf?no={_e.No}" : null)" Target="_blank"
                           Disabled="_e.No <= 0">印刷</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                           OnClick="保存" Disabled="_busy">@(_e.No <= 0 ? "登録" : "更新")</MudButton>
            </div>
        </div>
    </div>
</MudPaper>

@* 提出要否：カード外の共通ツールバー。DB列は「不要」のままで、UIは「提出する」＝チェックで提出（不要=false）に反転。 *@
<MudPaper Elevation="1" Class="mx-2 mt-2 px-4 py-2 d-flex align-center flex-wrap gap-6">
    <MudCheckBox T="bool" Value="@(!_e.不要)" ValueChanged="@((bool v) => _e.不要 = !v)"
                 Label="支払調書を提出する" Color="Color.Primary" Dense="true" />
</MudPaper>

<MudGrid Spacing="2" Class="pa-2">
    @* 支払を受ける者（入力形式は報酬に合わせた pay-row 形式） *@
    <MudItem xs="12">
        <MudPaper Elevation="1" Class="pa-4">
            <div class="proc-section-title">支払を受ける者</div>
            <div class="pay-list pay-list--2col">
                <div class="pay-row pay-row--required">
                    <span class="pay-row__label">氏名又は名称</span>
                    <span class="pay-row__amount pay-row__amount--grow">
                        <MudTextField @bind-Value="_e.名称" Variant="Variant.Text" Margin="Margin.Dense"
                                      Required="true" RequiredError="氏名又は名称を入力してください。" />
                    </span>
                </div>
                <div class="pay-row">
                    <span class="pay-row__label">住所（居所）又は所在地</span>
                    <span class="pay-row__amount pay-row__amount--grow">
                        <MudTextField @bind-Value="_e.所在地" Variant="Variant.Text" Margin="Margin.Dense" />
                    </span>
                </div>
                @NumberBlock(false)
            </div>
        </MudPaper>
    </MudItem>

    @* 明細（5区分：区分・物件の所在地・細目・計算の基礎・支払金額） *@
    <MudItem xs="12">
        <MudPaper Elevation="1" Class="pa-4">
            <div class="proc-section-title">明細</div>
            <div class="ye-amount-scroll">
                <MudSimpleTable Dense="true" Bordered="true" Class="ye-amount-table re-detail">
                    <thead>
                        <tr>
                            <th class="re-col-kubun">区分</th>
                            <th class="re-col-addr">物件の所在地</th>
                            <th class="re-col-txt">細目</th>
                            <th class="re-col-txt">計算の基礎</th>
                            <th class="re-detail__num">支払金額</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int k = 0; k < 5; k++)
                        {
                            var i = k;
                            <tr>
                                <td>
                                    <MudAutocomplete T="string" @bind-Value="_e.区分[i]" SearchFunc="Search区分"
                                                     Variant="Variant.Text" Margin="Margin.Dense" Dense="true"
                                                     CoerceValue="true" Clearable="true" ResetValueOnEmptyText="false"
                                                     Placeholder="地代 等" />
                                </td>
                                <td><MudTextField @bind-Value="_e.物件の所在地[i]" Variant="Variant.Text" Margin="Margin.Dense" /></td>
                                <td><MudTextField @bind-Value="_e.細目[i]" Variant="Variant.Text" Margin="Margin.Dense" /></td>
                                <td><MudTextField @bind-Value="_e.計算の基礎[i]" Variant="Variant.Text" Margin="Margin.Dense" /></td>
                                <td class="re-detail__num">@Num(() => _e.支払金額[i], v => _e.支払金額[i] = v)</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
            <MudText Typo="Typo.caption" Class="mt-1">区分の例：@string.Join("・", RealEstateRepository.区分候補)（一覧から選択・自由入力可）。支払金額のある行のみ区分が印字されます。</MudText>
        </MudPaper>
    </MudItem>

    @* 摘要 *@
    <MudItem xs="12">
        <MudPaper Elevation="1" Class="pa-4">
            <div class="proc-section-title">摘要</div>
            <MudTextField @bind-Value="_e.摘要" Variant="Variant.Outlined" Lines="2" />
        </MudPaper>
    </MudItem>

    @* あっせんをした者（入力形式は支払を受ける者に合わせた pay-row 形式） *@
    <MudItem xs="12">
        <MudPaper Elevation="1" Class="pa-4">
            <div class="proc-section-title">あっせんをした者</div>
            <div class="pay-list pay-list--2col">
                <div class="pay-row">
                    <span class="pay-row__label">氏名又は名称</span>
                    <span class="pay-row__amount pay-row__amount--grow">
                        <MudTextField @bind-Value="_e.あっせん名称" Variant="Variant.Text" Margin="Margin.Dense" />
                    </span>
                </div>
                <div class="pay-row">
                    <span class="pay-row__label">住所（居所）又は所在地</span>
                    <span class="pay-row__amount pay-row__amount--grow">
                        <MudTextField @bind-Value="_e.あっせん所在地" Variant="Variant.Text" Margin="Margin.Dense" />
                    </span>
                </div>
                <div class="pay-row">
                    <span class="pay-row__label">支払確定年月日</span>
                    <span class="pay-row__amount pay-row__amount--grow">
                        <DateInput Value="@Ymd(_e.支払確定年月日)" ValueChanged="@((string? v) => _e.支払確定年月日 = ParseYmd(v))" Width="160px" />
                    </span>
                </div>
                <div class="pay-row">
                    <span class="pay-row__label">あっせん手数料</span>
                    <span class="pay-row__amount pay-row__amount--grow">
                        <div class="ye-cell-amount">
                            <MudNumericField T="int?" @bind-Value="_e.あっせん手数料" Variant="Variant.Text"
                                             Format="#,##0" HideSpinButtons="true" Margin="Margin.Dense" InputMode="InputMode.numeric" Min="0"
                                             Class="ye-num ye-num--wide" />
                            <span class="pay-yen">円</span>
                        </div>
                    </span>
                </div>
                @NumberBlock(true)
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private IReadOnlyList<RealEstateListItem> _list = Array.Empty<RealEstateListItem>();
    private int? _selectedNo;
    private RealEstateRecord _e = new();
    private bool _busy;
    private bool _番号エラー;
    private bool _あっせん番号エラー;
    private string _番号エラーText = "";
    private string _あっせん番号エラーText = "";

    // 区分は現行 F_年調_不動産 の cmb_SiharaiKbn（編集可能なドロップダウン＝一覧選択＋自由入力）を移植。
    private Task<IEnumerable<string>> Search区分(string value, System.Threading.CancellationToken token)
    {
        IEnumerable<string> all = RealEstateRepository.区分候補;
        if (!string.IsNullOrWhiteSpace(value))
            all = all.Where(k => k.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(all);
    }

    // 個人番号／法人番号の入力（支払を受ける者・あっせんをした者で共用）。
    // 「法人／個人の区分」ラジオと「個人番号／法人番号」入力を同一行に横並びで返す。
    private RenderFragment NumberBlock(bool あっせん) =>
        @<text>
            <div class="pay-row pay-row--full">
                <span class="pay-row__label">法人／個人の区分</span>
                <span class="pay-row__amount pay-row__amount--grow d-flex align-center flex-wrap gap-6">
                    <MudRadioGroup T="string" Class="re-kbn-radio" Value="@(あっせん ? _e.あっせん者区分 : _e.支払受者区分)"
                                   ValueChanged="@((string v) => On区分Changed(v, あっせん))">
                        <MudRadio T="string" Value="@("1")" Color="Color.Primary" Dense="true">法人</MudRadio>
                        <MudRadio T="string" Value="@("2")" Color="Color.Primary" Dense="true">個人（個人事業主）</MudRadio>
                    </MudRadioGroup>
                    @if ((あっせん ? _e.あっせん者区分 : _e.支払受者区分) == "2")
                    {
                        <span class="d-flex align-center gap-2">
                            <span class="pay-row__label" style="width:auto;">個人番号（マイナンバー）</span>
                            <span style="font-family:monospace;">@Masked(あっせん ? _e.あっせん者番号 : _e.支払受者番号)</span>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Badge"
                                       OnClick="@(() => OpenMyNumberDialog(あっせん))">個人番号を入力</MudButton>
                        </span>
                    }
                    else
                    {
                        <span class="d-flex align-center gap-2">
                            <span class="pay-row__label" style="width:auto;">法人番号（13桁）</span>
                            <MudTextField T="string" Value="@(あっせん ? _e.あっせん者番号 : _e.支払受者番号)"
                                          ValueChanged="@((string v) => { if (あっせん) _e.あっせん者番号 = v; else _e.支払受者番号 = v; })"
                                          Variant="Variant.Text" Margin="Margin.Dense" Style="width:14em;"
                                          MaxLength="13" InputMode="InputMode.numeric"
                                          Error="@(あっせん ? _あっせん番号エラー : _番号エラー)"
                                          ErrorText="@(あっせん ? _あっせん番号エラーText : _番号エラーText)" />
                        </span>
                    }
                </span>
            </div>
         </text>;

    private RenderFragment Num(Func<int?> get, Action<int?> set) =>
        @<div class="ye-cell-amount">
            <MudNumericField T="int?" Value="get()" ValueChanged="@((int? v) => set(v))" Variant="Variant.Text"
                             Format="#,##0" HideSpinButtons="true" Margin="Margin.Dense" InputMode="InputMode.numeric" Min="0"
                             Class="ye-num ye-num--wide" />
            <span class="pay-yen">円</span>
         </div>;

    // 年月日入力（DateInput＝西暦8桁/和暦7桁で入力）とモデルの DateTime? を相互変換する。
    private static string? Ymd(DateTime? d) => d?.ToString("yyyy/MM/dd");
    private static DateTime? ParseYmd(string? v)
        => DateTime.TryParse(v, System.Globalization.CultureInfo.InvariantCulture,
                             System.Globalization.DateTimeStyles.None, out var d) ? d : null;

    // 個人番号は末尾4桁のみ表示、他はマスク。未登録は「未登録」。
    private static string Masked(string? number)
    {
        string n = number ?? "";
        if (string.IsNullOrEmpty(n)) return "未登録";
        if (n.Length <= 4) return new string('●', n.Length);
        return new string('●', n.Length - 4) + n[^4..];
    }

    private async Task OpenMyNumberDialog(bool あっせん)
    {
        string current = あっせん ? _e.あっせん者番号 : _e.支払受者番号;
        Db.LogRealEstateMyNumberView(current ?? "", あっせん);
        var parameters = new DialogParameters { ["Current"] = current ?? "" };
        var dialog = await Dialog.ShowAsync<Components.Shared.MyNumberInputDialog>("個人番号の入力", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is string v)
        {
            if (あっせん) { _e.あっせん者番号 = v; _あっせん番号エラー = false; }
            else { _e.支払受者番号 = v; _番号エラー = false; }
        }
    }

    protected override void OnInitialized()
    {
        _list = Db.ListRealEstates();
        新規();
    }

    private void On整理番号Changed(int? no)
    {
        _selectedNo = no;
        if (no is null) { 新規(); return; }
        _e = Db.LoadRealEstate(no.Value) ?? new RealEstateRecord();
        _番号エラー = _あっせん番号エラー = false;
    }

    private void 新規()
    {
        _selectedNo = null;
        _e = new RealEstateRecord { 支払受者区分 = "1", あっせん者区分 = "1", 不要 = true };
        _番号エラー = _あっせん番号エラー = false;
    }

    private void On区分Changed(string kubun, bool あっせん)
    {
        string v = kubun == "2" ? "2" : "1";
        if (あっせん) { _e.あっせん者区分 = v; _e.あっせん者番号 = ""; _あっせん番号エラー = false; }
        else { _e.支払受者区分 = v; _e.支払受者番号 = ""; _番号エラー = false; }
    }

    private bool 番号Valid(string 区分, string 番号)
    {
        string n = 番号 ?? "";
        if (n.Length == 0) return true; // 未入力は許容
        if (区分 == "2") return MyNumberValidator.IsValid(n);       // 個人番号＝12桁＋チェックデジット
        return n.All(char.IsDigit) && n.Length == 13;               // 法人番号＝13桁
    }

    private void 保存()
    {
        if (string.IsNullOrWhiteSpace(_e.名称)) { Snackbar.Add("氏名又は名称を入力してください。", Severity.Warning); return; }

        _番号エラー = !番号Valid(_e.支払受者区分, _e.支払受者番号);
        _あっせん番号エラー = !番号Valid(_e.あっせん者区分, _e.あっせん者番号);
        if (_番号エラー || _あっせん番号エラー)
        {
            _番号エラーText = _e.支払受者区分 == "2" ? "個人番号（12桁・チェックデジット）が正しくありません。" : "13桁の法人番号を入力してください。";
            _あっせん番号エラーText = _e.あっせん者区分 == "2" ? "個人番号（12桁・チェックデジット）が正しくありません。" : "13桁の法人番号を入力してください。";
            Snackbar.Add("番号の入力内容を確認してください。", Severity.Error);
            return;
        }

        _busy = true;
        try
        {
            int no = Db.SaveRealEstate(_e);
            _list = Db.ListRealEstates();
            _selectedNo = no;
            _e.No = no;
            Snackbar.Add($"整理番号 {no} を保存しました。", Severity.Success);
        }
        catch (Exception ex) { Snackbar.NotifyError("保存に失敗しました", ex); }
        finally { _busy = false; }
    }

    private async Task 削除()
    {
        if (_e.No <= 0) return;
        bool? ok = await Dialog.ShowMessageBoxAsync("確認", $"整理番号 {_e.No}（{_e.名称}）を削除します。よろしいですか？",
            yesText: "削除する", cancelText: "キャンセル");
        if (ok != true) return;

        _busy = true;
        try
        {
            Db.DeleteRealEstate(_e.No, _e.支払受者番号, _e.あっせん者番号);
            _list = Db.ListRealEstates();
            Snackbar.Add("削除しました。", Severity.Success);
            新規();
        }
        catch (Exception ex) { Snackbar.NotifyError("削除に失敗しました", ex); }
        finally { _busy = false; }
    }
}

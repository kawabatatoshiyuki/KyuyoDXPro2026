@page "/year-end/summary"

<PageTitle>集計表（納付書用）の印刷｜給与計算DXPro</PageTitle>

<style>
    .sum-desc { background:var(--mud-palette-background-grey); border-radius:8px; padding:12px 16px;
                font-size:0.85rem; line-height:1.6; color:var(--mud-palette-text-secondary); }
    .sum-groups { display:flex; flex-direction:column; gap:20px; margin-top:8px; }
</style>

@* 固定ヘッダー：タイトル＋プレビュー／PDF出力（賃金台帳と同様の印刷指示バー）。 *@
<MudPaper Elevation="2" Square="true" Class="page-sticky-header py-3 px-2">
    <div class="proc-header__bar">
        <div class="proc-header__main">
            <div class="proc-header__title">
                <MudIcon Icon="@Icons.Material.Filled.Summarize" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.h5">集計表（納付書用）</MudText>
            </div>
        </div>
        <div class="proc-header__actions">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Preview"
                       OnClick="Preview">プレビュー</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PictureAsPdf"
                       Href="@PdfUrl" Target="_blank">PDF出力（別タブ）</MudButton>
        </div>
    </div>
</MudPaper>

<MudGrid Spacing="3">
    <MudItem xs="12" md="4">
        <MudPaper Elevation="1" Class="pa-4">
            <div class="sum-desc mb-4">
                年末調整の計算が終わり、過納額や不足額の清算をした場合は、その内容を年末調整をした月分の
                「所得税徴収高計算書（納付書）」に記載したうえで徴収税額を納付します。
                この集計表は納付書への記載を補助するためのもので、集計期間と期間に含める賞与を選んで印刷します。
            </div>

            <div class="sum-groups">
                <div>
                    <MudText Typo="Typo.subtitle2" Class="mb-1">集計期間</MudText>
                    <MudRadioGroup T="int" Value="_syukei" ValueChanged="OnSyukeiChanged">
                        <MudRadio Value="1" Color="Color.Primary" Dense="true">納期特例（7月～12月）</MudRadio>
                        <MudRadio Value="2" Color="Color.Primary" Dense="true">一般（12月のみ）</MudRadio>
                    </MudRadioGroup>
                </div>

                <div>
                    <MudText Typo="Typo.subtitle2" Class="mb-1">期間に含む賞与</MudText>
                    <MudRadioGroup T="int" Value="_syouyo" ValueChanged="OnSyouyoChanged">
                        <MudRadio Value="1" Color="Color.Primary" Dense="true">4回目のみ</MudRadio>
                        <MudRadio Value="2" Color="Color.Primary" Dense="true">3，4回目とも</MudRadio>
                        <MudRadio Value="3" Color="Color.Primary" Dense="true">2，3，4回目とも</MudRadio>
                        <MudRadio Value="4" Color="Color.Primary" Dense="true">1，2，3，4回目とも</MudRadio>
                        <MudRadio Value="5" Color="Color.Primary" Dense="true">含まない</MudRadio>
                    </MudRadioGroup>
                </div>
            </div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="8">
        <div class="mt-1">
            @if (string.IsNullOrEmpty(_previewUrl))
            {
                <MudPaper Elevation="1" Class="pa-6">
                    <MudText Class="pa-3" Color="Color.Secondary">「プレビュー」を押すと、集計表を右側に表示します。</MudText>
                </MudPaper>
            }
            else
            {
                <iframe src="@_previewUrl" style="width:100%;height:82vh;border:1px solid var(--mud-palette-divider);border-radius:6px;"></iframe>
            }
        </div>
    </MudItem>
</MudGrid>

@code {
    // 既定：納期特例(7〜12月)＋4回目のみ（現行 F_集計表印刷 の既定チェック）。
    private int _syukei = 1;
    private int _syouyo = 1;
    private string _previewUrl = "";

    private string PdfUrl => $"/year-end/summary/pdf?syukei={_syukei}&syouyo={_syouyo}";

    // 条件を変えたらプレビューは古くなるので消す（賃金台帳と同じ挙動）。
    private void OnSyukeiChanged(int v) { _syukei = v; _previewUrl = ""; }
    private void OnSyouyoChanged(int v) { _syouyo = v; _previewUrl = ""; }

    private void Preview() => _previewUrl = PdfUrl;
}

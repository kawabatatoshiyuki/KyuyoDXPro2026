@page "/year-end/pay-report-summary"

<PageTitle>給与支払報告書（総括表）の印刷｜給与計算DXPro</PageTitle>

<style>
    .prs-desc { background:var(--mud-palette-background-grey); border-radius:8px; padding:12px 16px;
                font-size:0.85rem; line-height:1.6; color:var(--mud-palette-text-secondary); }
    .prs-groups { display:flex; flex-direction:column; gap:20px; margin-top:8px; }
</style>

@* 固定ヘッダー：タイトル＋プレビュー／PDF出力（合計表と同じ印刷指示バー）。 *@
<MudPaper Elevation="2" Square="true" Class="page-sticky-header py-3 px-2">
    <div class="proc-header__bar">
        <div class="proc-header__main">
            <div class="proc-header__title">
                <MudIcon Icon="@Icons.Material.Filled.Summarize" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.h5">給与支払報告書（総括表）の印刷</MudText>
            </div>
        </div>
        <div class="proc-header__actions">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Preview"
                       OnClick="Preview">プレビュー</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PictureAsPdf"
                       Href="@PdfUrl" Target="_blank">PDF出力（別タブ）</MudButton>
        </div>
    </div>
</MudPaper>

<MudGrid Spacing="3">
    <MudItem xs="12" md="4">
        <MudPaper Elevation="1" Class="pa-4">
            <div class="prs-desc mb-4">
                「給与支払報告書（総括表）」を印刷します。市区町村（提出先）ごとに、給与の支払期間・報告人員・
                そのうち退職者人員を、登録済みの年末調整データから自動集計します（提出先は最大4件を1ページに面付け）。
                会社情報（法人番号・所在地・連絡先ほか）は<MudLink Href="/setup/company">会社情報</MudLink>の登録値、
                提出先は同画面の「報告書提出先」の登録値を使用します。
            </div>
            <div class="prs-groups">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    集計対象は全社の登録データです。印刷前に会社情報・報告書提出先・年末調整の登録内容をご確認ください。
                </MudText>
            </div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="8">
        <div class="mt-1">
            @if (string.IsNullOrEmpty(_previewUrl))
            {
                <MudPaper Elevation="1" Class="pa-6">
                    <MudText Class="pa-3" Color="Color.Secondary">「プレビュー」を押すと、給与支払報告書（総括表）を右側に表示します。</MudText>
                </MudPaper>
            }
            else
            {
                <iframe src="@_previewUrl" style="width:100%;height:82vh;border:1px solid var(--mud-palette-divider);border-radius:6px;"></iframe>
            }
        </div>
    </MudItem>
</MudGrid>

@code {
    private string _previewUrl = "";

    private string PdfUrl => "/year-end/pay-report-summary/pdf";

    private void Preview() => _previewUrl = PdfUrl;
}

@page "/payroll/reports"
@using PayCalcDXPro.Data.Employee
@inject PayCalcDXPro.Web.LocalDatabaseService Db
@inject ISnackbar Snackbar

<PageTitle>関連帳票｜給与計算DXPro</PageTitle>

<MudPaper Elevation="2" Square="true" Class="page-sticky-header py-3 px-2">
    <div class="proc-header__bar">
        <div class="proc-header__main">
            <div class="proc-header__title">
                <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.h5">関連帳票</MudText>
            </div>
            <div class="proc-header__controls">
                <MudSelect T="string" Value="_report" ValueChanged="OnReportChanged" Label="帳票"
                           Variant="Variant.Outlined" Dense="true" Style="min-width:190px;">
                    <MudSelectItem T="string" Value="@("bank")">銀行振込一覧表</MudSelectItem>
                    <MudSelectItem T="string" Value="@("kinsyu")">現金支給金種表</MudSelectItem>
                    <MudSelectItem T="string" Value="@("envelope")">給与/賞与封筒印刷</MudSelectItem>
                </MudSelect>
                <MudSelect T="string" Value="_kind" ValueChanged="OnKindChanged" Label="給与／賞与"
                           Variant="Variant.Outlined" Dense="true" Style="min-width:120px;">
                    <MudSelectItem T="string" Value="@("salary")">給与</MudSelectItem>
                    <MudSelectItem T="string" Value="@("bonus")">賞与</MudSelectItem>
                </MudSelect>
                <MudSelect T="int" Value="_round" ValueChanged="OnRoundChanged" Label="@(_kind == "bonus" ? "賞与回" : "支給月分")"
                           Variant="Variant.Outlined" Dense="true" Style="min-width:200px;">
                    @foreach (var r in CurrentRounds())
                    {
                        int v = r.回;
                        <MudSelectItem T="int" Value="v">@r.ラベル</MudSelectItem>
                    }
                </MudSelect>
                @if (_report == "kinsyu")
                {
                    <MudSwitch T="bool" Value="_yen2000" ValueChanged="OnYen2000Changed" Color="Color.Primary"
                               Label="2,000円札を含める" />
                }
                @if (_report == "envelope")
                {
                    <MudSelect T="bool" Value="_landscape" ValueChanged="OnLandscapeChanged" Label="封筒の向き"
                               Variant="Variant.Outlined" Dense="true" Style="min-width:130px;">
                        <MudSelectItem T="bool" Value="false">縦長封筒</MudSelectItem>
                        <MudSelectItem T="bool" Value="true">横長封筒</MudSelectItem>
                    </MudSelect>
                }
            </div>
        </div>
        <div class="proc-header__actions">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Preview"
                       OnClick="Preview" Disabled="@(!CanOutput())">プレビュー</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PictureAsPdf"
                       Href="@PdfUrl" Target="_blank" Disabled="@(!CanOutput())">PDF出力（別タブ）</MudButton>
        </div>
    </div>
</MudPaper>

<MudGrid Spacing="3">
    <MudItem xs="12" md="4">
        <MudPaper Elevation="1" Class="pa-4">
            @if (_report == "kinsyu")
            {
                <div class="proc-section-title">現金支給金種表</div>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">
                    ・従業員情報登録で給与の支払先が「現金支給」の従業員のみが対象です。<br />
                    ・選択した支給回の支払金額（差引支給額）を金種（10000〜1円）に分解して一覧します。<br />
                    ・「2,000円札を含める」をオフにすると2,000円札を使わない金種内訳になります。<br />
                    ・末尾に支払金額・各金種の合計を表示します。
                </MudText>
            }
            else if (_report == "envelope")
            {
                <div class="proc-section-title">給与/賞与封筒印刷</div>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">
                    ・選択した従業員ごとに長3封筒1名1枚（明細書名・支給日・No.・部門・氏名・会社名）を印字します。<br />
                    ・「封筒の向き」で縦長／横長封筒を切り替えます。<br />
                    ・「賃金が発生していない従業員も含める」をオンにすると、当回に給与（賞与）の無い在籍者も対象にできます。
                </MudText>
            }
            else
            {
                <div class="proc-section-title">銀行振込一覧表</div>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">
                    ・従業員情報登録で給与の支払先に金融機関が選択されている（現金支給以外の）従業員のみが対象です。<br />
                    ・選択した支給回の振込先金融機関・口座番号・振込金額（差引支給額）を一覧します。<br />
                    ・末尾に合計件数・合計金額を表示します。
                </MudText>
            }
        </MudPaper>

        @if (!CurrentRounds().Any())
        {
            <MudPaper Elevation="1" Class="pa-4 mt-3">
                <MudText Color="Color.Secondary">
                    @(_kind == "bonus" ? "賞与の支給予定" : "給与の支給月")が登録されていません。先に「支給日情報」を登録してください。
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/setup/paydays"
                           StartIcon="@Icons.Material.Filled.EditCalendar" Class="mt-3">支給日情報へ</MudButton>
            </MudPaper>
        }
        else if (_report == "envelope")
        {
            <MudPaper Elevation="1" Class="pa-4 mt-3">
                <div class="proc-section-title">従業員の選択</div>
                <MudSwitch T="bool" Value="_includeEmpty" ValueChanged="OnIncludeEmptyChanged" Color="Color.Primary"
                           Label="賃金が発生していない従業員も含める" Class="mb-1" />
                @if (_saved.Count == 0 && !_includeEmpty)
                {
                    <MudText Color="Color.Secondary" Class="mt-2">この@(_kind == "bonus" ? "賞与回" : "支給月")に計算・保存済みの@(_kind == "bonus" ? "賞与" : "給与")がありません。</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@(_kind == "bonus" ? "/bonus/process" : "/payroll/process")"
                               StartIcon="@Icons.Material.Filled.Calculate" Class="mt-3">@(_kind == "bonus" ? "賞与計算へ" : "給与計算へ")</MudButton>
                }
                else
                {
                    var selectable = Selectable().ToList();
                    var filtered = selectable.Where(MatchSearch).ToList();
                    <div class="d-flex align-center justify-space-between flex-wrap" style="gap:8px;">
                        <MudCheckBox T="bool" Value="@(selectable.Count > 0 && selectable.All(x => _selected.Contains(x.Number)))"
                                     ValueChanged="@((bool v) => ToggleAll(v, selectable))" Color="Color.Primary"
                                     Label="全ての従業員を選択する" Dense="true" />
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">
                            @_selected.Count 人選択中 / 全 @selectable.Count 人
                        </MudChip>
                    </div>
                    <MudTextField @bind-Value="_search" Immediate="true" DebounceInterval="150"
                                  Placeholder="氏名・No で絞り込み" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Clearable="true" Class="my-2" />
                    <MudDivider Class="my-2" />
                    <div style="max-height:calc(100vh - 360px);overflow:auto;">
                        @if (filtered.Count == 0)
                        {
                            <MudText Color="Color.Secondary" Class="pa-2">該当する従業員がいません。</MudText>
                        }
                        else
                        {
                            @foreach (var it in filtered)
                            {
                                int num = it.Number;
                                bool 賃金なし = !_saved.Contains(num);
                                <MudCheckBox T="bool" Value="_selected.Contains(num)"
                                             ValueChanged="@((bool v) => ToggleOne(num, v))" Dense="true" Color="Color.Primary"
                                             Label="@($"{it.氏名}（No.{it.No}）{(賃金なし ? "　※賃金なし" : "")}")" />
                            }
                        }
                    </div>
                }
            </MudPaper>
        }
    </MudItem>

    <MudItem xs="12" md="8">
        <div class="mt-1">
            @if (string.IsNullOrEmpty(_previewUrl))
            {
                <MudPaper Elevation="1" Class="pa-6">
                    <MudText Class="pa-3" Color="Color.Secondary">「プレビュー」を押すと、帳票を右側に表示します。</MudText>
                </MudPaper>
            }
            else
            {
                <iframe src="@_previewUrl" style="width:100%;height:82vh;border:1px solid var(--mud-palette-divider);border-radius:6px;"></iframe>
            }
        </div>
    </MudItem>
</MudGrid>

@code {
    private string _report = "bank";
    private string _kind = "salary";
    private int _round = 1;
    private bool _yen2000;
    private bool _landscape;        // 封筒：true=横長封筒（R_封筒Y）
    private bool _includeEmpty;     // 封筒：賃金が発生していない従業員も含める
    private string _search = "";
    private string _previewUrl = "";
    private WageLedgerOptions _opt = new(Array.Empty<WageLedgerRound>(), Array.Empty<WageLedgerRound>(), Array.Empty<string>(), "給与", 1);

    // 封筒の従業員選択（明細書印刷と同じメタ・対象選別）
    private IReadOnlyList<EmployeeListItem> _employees = Array.Empty<EmployeeListItem>();
    private HashSet<int> _saved = new();
    private HashSet<int> _selected = new();

    private IEnumerable<WageLedgerRound> CurrentRounds()
        => (_kind == "bonus" ? _opt.賞与回 : _opt.給与回).Where(x => x.選択可);

    // 封筒の選択対象。通常は保存済みのみ。賃金なしも含める場合は在籍者（退職以外）＋保存済み。
    private IEnumerable<EmployeeListItem> Selectable()
        => _includeEmpty
            ? _employees.Where(x => _saved.Contains(x.Number) || !x.退職)
            : _employees.Where(x => _saved.Contains(x.Number));

    private bool MatchSearch(EmployeeListItem it)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        var s = _search.Trim();
        return (it.氏名?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
            || (it.No?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private bool CanOutput()
        => _report == "envelope" ? Selectable().Any() : CurrentRounds().Any();

    private string PdfUrl
    {
        get
        {
            if (_report == "kinsyu")
                return $"/payroll/kinsyu/pdf?kind={_kind}&round={_round}&yen2000={_yen2000.ToString().ToLower()}";
            if (_report == "envelope")
            {
                // 賃金なしを含める時は対象が保存済みと異なるため、選択中Numberを明示送信する。
                bool allSaved = !_includeEmpty && _saved.Count > 0 && _selected.Count == _saved.Count;
                string nums = (_selected.Count == 0 || allSaved) ? "" : string.Join(",", _selected);
                return $"/payroll/envelope/pdf?kind={_kind}&round={_round}&landscape={_landscape.ToString().ToLower()}&empty={_includeEmpty.ToString().ToLower()}&nums={nums}";
            }
            return $"/payroll/bank-transfer/pdf?kind={_kind}&round={_round}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _opt = await Task.Run(() => Db.GetWageLedgerOptions());
            _kind = _opt.既定種別 == "賞与" ? "bonus" : "salary";
            _round = _opt.既定回;
            EnsureValidRound();
        }
        catch (Exception ex) { Snackbar.NotifyError("読み込みに失敗しました", ex); }
    }

    private void EnsureValidRound()
    {
        var rounds = CurrentRounds().ToList();
        if (rounds.Count == 0) return;
        if (!rounds.Any(r => r.回 == _round)) _round = rounds[0].回;
    }

    // 封筒選択時のみ、対象支給回の従業員・保存済みを読み込む。
    private async Task LoadEnvelopeEmployees()
    {
        if (_report != "envelope") return;
        try
        {
            if (_kind == "bonus")
            {
                var meta = await Task.Run(() => Db.LoadBonusMeta(_round));
                _employees = meta.従業員;
                _saved = meta.保存済従業員.ToHashSet();
            }
            else
            {
                var meta = await Task.Run(() => Db.LoadPayrollMeta(_round));
                _employees = meta.従業員;
                _saved = meta.保存済従業員.ToHashSet();
            }
            _selected = _saved.ToHashSet();
        }
        catch (Exception ex) { Snackbar.NotifyError("従業員の読み込みに失敗しました", ex); }
    }

    private async Task OnReportChanged(string r)
    {
        _report = r;
        _previewUrl = "";
        await LoadEnvelopeEmployees();
    }

    private async Task OnKindChanged(string k)
    {
        _kind = k;
        EnsureValidRound();
        _previewUrl = "";
        await LoadEnvelopeEmployees();
    }

    private async Task OnRoundChanged(int r)
    {
        _round = r;
        _previewUrl = "";
        await LoadEnvelopeEmployees();
    }

    private void OnYen2000Changed(bool v) { _yen2000 = v; _previewUrl = ""; }
    private void OnLandscapeChanged(bool v) { _landscape = v; _previewUrl = ""; }

    private void OnIncludeEmptyChanged(bool v)
    {
        _includeEmpty = v;
        if (!v) _selected.IntersectWith(_saved);   // オフ時は保存済み以外の選択を解除
        _previewUrl = "";
    }

    private void ToggleAll(bool v, List<EmployeeListItem> selectable)
        => _selected = v ? selectable.Select(x => x.Number).ToHashSet() : new();

    private void ToggleOne(int number, bool v)
    {
        if (v) _selected.Add(number); else _selected.Remove(number);
    }

    private void Preview() => _previewUrl = PdfUrl;
}

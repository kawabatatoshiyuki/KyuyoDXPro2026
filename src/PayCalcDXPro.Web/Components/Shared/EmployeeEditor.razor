@code {
    [Parameter] public Employee Model { get; set; } = new();
    [Parameter] public EmployeeFormOptions Options { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public EventCallback<int> OnSaved { get; set; }
    [Parameter] public EventCallback OnDeleted { get; set; }

    private MudForm _form = default!;
    // 選択タブは回線単位で保持（別従業員へ切替えても、別画面から戻っても直前のタブを維持）。
    private int ActiveTab { get => TabState.Get("employee-editor"); set => TabState.Set("employee-editor", value); }
    private bool _saving;
    private DateTime? _birth;
    private DateTime? _joinLeave;
    private Employee? _bound;

    // 振込銀行=現金支給(番号1)のとき預金種類・口座番号は不要。
    private bool 現金支給 => Model.銀行番号 == "1";

    private void OnBankChanged(string v)
    {
        Model.銀行番号 = v;
        if (v == "1")
        {
            // 現金支給に切り替えたら入力値を初期化。
            Model.預金種類 = "";
            Model.口座番号 = "";
        }
        else if (string.IsNullOrEmpty(Model.預金種類))
        {
            Model.預金種類 = "1"; // 銀行を選んだら既定=普通
        }
    }

    private bool 健康保険加入 { get => Model.健康保険 == "1"; set => Model.健康保険 = value ? "1" : "2"; }
    private bool 介護保険加入 { get => Model.介護保険 == "1"; set => Model.介護保険 = value ? "1" : "2"; }
    private bool 子育支援加入 { get => Model.子育支援 == "1"; set => Model.子育支援 = value ? "1" : "2"; }
    private bool 厚生年金加入 { get => Model.厚生年金 == "1"; set => Model.厚生年金 = value ? "1" : "2"; }
    private bool 年金基金加入 { get => Model.年金基金 == "1"; set => Model.年金基金 = value ? "1" : "2"; }
    private bool 雇用保険加入 { get => Model.雇用保険 == "1"; set => Model.雇用保険 = value ? "1" : "2"; }

    protected override void OnParametersSet()
    {
        // 親が別の従業員（別インスタンス）に切り替えたら日付・タブを同期する。
        if (!ReferenceEquals(_bound, Model))
        {
            _bound = Model;
            _birth = ParseDate(Model.生年月日);
            _joinLeave = ParseDate(Model.就退年月日);
            // タブは維持する（従業員を切り替えても直前に開いていたタブのまま）。
        }
    }

    /// <summary>親（固定ヘッダーの「更新する」）からも呼べる保存。</summary>
    public async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            Snackbar.Add("入力内容を確認してください。", Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(Model.フリガナ))
        {
            Snackbar.Add("フリガナは必須です。", Severity.Warning);
            return;
        }

        Model.生年月日 = FmtDate(_birth);
        Model.就退年月日 = FmtDate(_joinLeave);

        // 現金支給は預金種類・口座番号を保持しない（既存の不整合データも保存時に初期化）。
        if (現金支給)
        {
            Model.預金種類 = "";
            Model.口座番号 = "";
        }

        if (Model.就退区分 is "2" or "3" or "4" && string.IsNullOrEmpty(Model.就退年月日))
        {
            Snackbar.Add("中途就職・退職・死亡退職の場合は就職・退職日を入力してください。", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var toSave = Model;
            int number = await Task.Run(() => Db.SaveEmployee(toSave));
            Snackbar.Add("従業員を登録しました。", Severity.Success);
            await OnSaved.InvokeAsync(number);
        }
        catch (Exception ex)
        {
            Snackbar.NotifyError("登録に失敗しました", ex);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        bool? ok = await Dialog.ShowMessageBoxAsync(
            "従業員の削除",
            $"「{Model.氏名}」（No.{Model.No}）を削除します。よろしいですか？",
            yesText: "削除", cancelText: "キャンセル");
        if (ok != true) return;

        _saving = true;
        try
        {
            int num = Model.Number;
            await Task.Run(() => Db.DeleteEmployee(num));
            Snackbar.Add("削除しました。", Severity.Success);
            await OnDeleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.NotifyError("削除に失敗しました", ex);
        }
        finally
        {
            _saving = false;
        }
    }

    private static DateTime? ParseDate(string s) => DateTime.TryParse(s, out var d) ? d : null;
    private static string FmtDate(DateTime? d) => d?.ToString("yyyy/MM/dd") ?? "";
}

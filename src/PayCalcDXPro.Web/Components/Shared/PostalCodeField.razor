@namespace PayCalcDXPro.Web.Components.Shared
@using PayCalcDXPro.Domain.Formatting

@* 郵便番号入力。保存値は数字のみ（最大7桁）、表示は「123-4567」。自動の住所展開は将来対応。 *@
<MudTextField T="string" Value="Value" ValueChanged="OnChanged" Converter="_converter"
              Label="@Label" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="8" InputMode="InputMode.numeric"
              Adornment="Adornment.Start" AdornmentText="〒"
              Validation="@(new Func<string, string?>(Validate))" />

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "郵便番号";

    // 値→表示は整形、表示→値は数字のみへ正規化（フォーカスアウト時に適用）。
    private static readonly DeferredConverter<string, string> _converter = MakeConverter();

    private static DeferredConverter<string, string> MakeConverter()
    {
        var c = new DeferredConverter<string, string>();
        c.Set(v => InputFormat.FormatPostalCode(v), t => InputFormat.NormalizePostalCode(t));
        return c;
    }

    private async Task OnChanged(string value)
    {
        // value は ConvertBack 適用後の生値（数字のみ）。
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }

    private static string? Validate(string v)
        => InputFormat.IsValidPostalCode(v) ? null : "郵便番号は7桁で入力してください。";
}
